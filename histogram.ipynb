   "source": [
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "dane = np.random.normal(0, 1, 1000)\n",
    "\n",
    "plt.hist(dane, bins=30, edgecolor=\"black\")\n",
    "plt.title(\"Histogram losowych danych\")\n",
    "plt.xlabel(\"Wartość\")\n",
    "plt.ylabel(\"Liczebność\")\n",
    "plt.show()"
   ]
  }
 ],
